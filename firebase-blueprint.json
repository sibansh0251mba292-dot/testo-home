{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profile stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 20 },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "createdAt", "lastLoginAt", "updatedAt"]
    },
    "SavedAddress": {
      "title": "SavedAddress",
      "description": "Saved home collection address for a customer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "addressLine": { "type": "string", "minLength": 5, "maxLength": 240 },
        "landmark": { "type": "string", "maxLength": 120 },
        "pincode": { "type": "string", "pattern": "^[0-9]{6}$", "maxLength": 6 },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "label", "addressLine", "pincode", "isDefault", "createdAt", "updatedAt"]
    },
    "PatientProfile": {
      "title": "PatientProfile",
      "description": "Customer or family member patient profile for diagnostic bookings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "relation": { "type": "string", "minLength": 1, "maxLength": 40 },
        "mobile": { "type": "string", "pattern": "^[0-9+\\-\\s]{10,15}$", "maxLength": 15 },
        "bloodGroup": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "age", "gender", "relation", "mobile", "createdAt", "updatedAt"]
    },
    "DiagnosticTest": {
      "title": "DiagnosticTest",
      "description": "Individual blood test in the diagnostic catalogue.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "nameHi": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "shortDescription": { "type": "string", "minLength": 5, "maxLength": 300 },
        "shortDescriptionHi": { "type": "string", "maxLength": 360 },
        "price": { "type": "number" },
        "discountedPrice": { "type": "number" },
        "isDemoPrice": { "type": "boolean" },
        "preparation": { "type": "string", "maxLength": 300 },
        "preparationHi": { "type": "string", "maxLength": 360 },
        "fastingRequired": { "type": "boolean" },
        "fastingHours": { "type": "number" },
        "reportDeliveryHours": { "type": "number" },
        "sampleType": { "type": "string", "maxLength": 60 },
        "isPopular": { "type": "boolean" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "shortDescription", "price", "discountedPrice", "isDemoPrice", "preparation", "fastingRequired", "reportDeliveryHours", "active", "updatedAt"]
    },
    "HealthPackage": {
      "title": "HealthPackage",
      "description": "Bundled preventive health checkup package.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "nameHi": { "type": "string", "maxLength": 160 },
        "tagline": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "minLength": 5, "maxLength": 400 },
        "descriptionHi": { "type": "string", "maxLength": 460 },
        "includedTests": { "type": "array" },
        "testCount": { "type": "number" },
        "price": { "type": "number" },
        "discountedPrice": { "type": "number" },
        "isDemoPrice": { "type": "boolean" },
        "fastingRequired": { "type": "boolean" },
        "fastingHours": { "type": "number" },
        "reportDeliveryHours": { "type": "number" },
        "isRecommended": { "type": "boolean" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "includedTests", "testCount", "price", "discountedPrice", "isDemoPrice", "fastingRequired", "reportDeliveryHours", "active", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Home sample collection booking.",
      "type": "object",
      "properties": {
        "bookingCode": { "type": "string", "minLength": 4, "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "finalAmount": { "type": "number" },
        "offerCode": { "type": "string", "maxLength": 32 },
        "patientName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "patientAge": { "type": "number" },
        "patientGender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "patientMobile": { "type": "string", "pattern": "^[0-9+\\-\\s]{10,15}$", "maxLength": 15 },
        "addressLine": { "type": "string", "minLength": 5, "maxLength": 240 },
        "landmark": { "type": "string", "maxLength": 120 },
        "pincode": { "type": "string", "pattern": "^[0-9]{6}$", "maxLength": 6 },
        "collectionDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "timeSlot": { "type": "string", "minLength": 3, "maxLength": 60 },
        "paymentMethod": { "type": "string", "enum": ["UPI", "Cash on Collection", "Online Payment"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "awaiting_verification", "paid", "failed"] },
        "paymentReference": { "type": "string", "maxLength": 120 },
        "razorpayOrderId": { "type": "string", "maxLength": 100 },
        "razorpayPaymentId": { "type": "string", "maxLength": 100 },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Phlebotomist Assigned", "Sample Collected", "Processing", "Report Ready", "Cancelled"]
        },
        "assignedAgentId": { "type": "string", "maxLength": 128 },
        "assignedAgentName": { "type": "string", "maxLength": 120 },
        "assignedAgentPhone": { "type": "string", "maxLength": 20 },
        "rescheduleRequestedDate": { "type": "string", "maxLength": 10 },
        "rescheduleRequestedSlot": { "type": "string", "maxLength": 60 },
        "cancellationReason": { "type": "string", "maxLength": 240 },
        "consentAccepted": { "type": "boolean" },
        "isDemoBooking": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "bookingCode", "userId", "items", "totalAmount", "discountAmount", "finalAmount",
        "patientName", "patientAge", "patientGender", "patientMobile", "addressLine", "pincode",
        "collectionDate", "timeSlot", "paymentMethod", "paymentStatus", "status",
        "consentAccepted", "createdAt", "updatedAt"
      ]
    },
    "DiagnosticReport": {
      "title": "DiagnosticReport",
      "description": "Authorized diagnostic PDF report metadata linked to a user and booking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingCode": { "type": "string", "maxLength": 32 },
        "patientName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reportTitle": { "type": "string", "minLength": 2, "maxLength": 160 },
        "testSummary": { "type": "string", "maxLength": 300 },
        "storagePath": { "type": "string", "maxLength": 300 },
        "downloadUrl": { "type": "string", "maxLength": 1000 },
        "fileName": { "type": "string", "maxLength": 160 },
        "remarks": { "type": "string", "maxLength": 500 },
        "notified": { "type": "boolean" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bookingId", "bookingCode", "patientName", "reportTitle", "fileName", "issuedAt", "createdAt", "updatedAt"]
    },
    "Phlebotomist": {
      "title": "Phlebotomist",
      "description": "Trained home sample collection technician managed by admins.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "pattern": "^[0-9+\\-\\s]{10,15}$", "maxLength": 15 },
        "certificationCode": { "type": "string", "maxLength": 40 },
        "zonePincodes": { "type": "array" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "certificationCode", "zonePincodes", "active", "updatedAt"]
    },
    "ServiceablePincode": {
      "title": "ServiceablePincode",
      "description": "Pincode serviceable for home blood sample collection.",
      "type": "object",
      "properties": {
        "pincode": { "type": "string", "pattern": "^[0-9]{6}$", "maxLength": 6 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "area": { "type": "string", "minLength": 2, "maxLength": 120 },
        "serviceFee": { "type": "number" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pincode", "city", "area", "serviceFee", "active", "updatedAt"]
    },
    "CollectionSlot": {
      "title": "CollectionSlot",
      "description": "Available home sample collection time window.",
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 3, "maxLength": 60 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "maxBookings": { "type": "number" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["label", "startTime", "endTime", "maxBookings", "active", "updatedAt"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Promotional discount offer.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "titleHi": { "type": "string", "maxLength": 140 },
        "code": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "discountPercent": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "description": { "type": "string", "maxLength": 240 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "code", "discountPercent", "maxDiscount", "description", "active", "updatedAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized platform administrator record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "name": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "createdAt"]
    },
    "OperationalConfig": {
      "title": "OperationalConfig",
      "description": "Operational readiness flags for live diagnostic booking acceptance.",
      "type": "object",
      "properties": {
        "liveBookingsEnabled": { "type": "boolean" },
        "labConfigured": { "type": "boolean" },
        "staffConfigured": { "type": "boolean" },
        "pricingConfigured": { "type": "boolean" },
        "locationsConfigured": { "type": "boolean" },
        "supportPhone": { "type": "string", "maxLength": 20 },
        "supportWhatsApp": { "type": "string", "maxLength": 20 },
        "supportEmail": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["liveBookingsEnabled", "labConfigured", "staffConfigured", "pricingConfigured", "locationsConfigured", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile documents indexed by Firebase Auth UID."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/SavedAddress" },
      "description": "Customer saved collection addresses."
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/PatientProfile" },
      "description": "Family member profiles owned by a customer."
    },
    "/tests/{testId}": {
      "schema": { "$ref": "#/entities/DiagnosticTest" },
      "description": "Blood test catalogue."
    },
    "/packages/{packageId}": {
      "schema": { "$ref": "#/entities/HealthPackage" },
      "description": "Health checkup packages."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Home sample collection bookings."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/DiagnosticReport" },
      "description": "Completed diagnostic test reports."
    },
    "/phlebotomists/{phlebotomistId}": {
      "schema": { "$ref": "#/entities/Phlebotomist" },
      "description": "Trained phlebotomist roster."
    },
    "/serviceable_pincodes/{pincode}": {
      "schema": { "$ref": "#/entities/ServiceablePincode" },
      "description": "Serviceable pincodes for home collection."
    },
    "/time_slots/{slotId}": {
      "schema": { "$ref": "#/entities/CollectionSlot" },
      "description": "Available collection time slots."
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "#/entities/Offer" },
      "description": "Promotional discount offers."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Role-protected administrator registry."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/OperationalConfig" },
      "description": "Platform operational configuration."
    }
  }
}
